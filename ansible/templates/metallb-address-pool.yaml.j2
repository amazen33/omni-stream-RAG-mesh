apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: rag-ingress
  namespace: metallb-system
spec:
  addresses:
{% for address in metallb_address_pool %}
    - {{ address | quote }}
{% endfor %}
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: rag-ingress
  namespace: metallb-system
spec:
  ipAddressPools: [rag-ingress]
