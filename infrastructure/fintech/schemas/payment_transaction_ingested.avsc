{
  "type": "record",
  "name": "PaymentTransactionIngested",
  "namespace": "omni.payments.v2",
  "fields": [
    {"name": "event_id", "type": "string"},
    {"name": "occurred_at", "type": "string"},
    {"name": "correlation_id", "type": "string"},
    {"name": "causation_id", "type": "string"},
    {"name": "traceparent", "type": "string"},
    {"name": "transaction_token", "type": "string"},
    {"name": "merchant_token", "type": "string"},
    {"name": "amount_minor", "type": "long"},
    {"name": "currency", "type": "string"},
    {"name": "payment_network", "type": "string"},
    {"name": "pii_tokenized", "type": "boolean", "default": true},
    {"name": "event_type", "type": "string"},
    {"name": "topic", "type": "string"}
  ]
}
