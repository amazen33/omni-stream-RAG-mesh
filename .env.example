# Development only. Replace secrets before enabling external integrations.
MINIO_ROOT_USER=replace-local-user
MINIO_ROOT_PASSWORD=replace-local-password
AWS_ACCESS_KEY_ID=replace-local-user
AWS_SECRET_ACCESS_KEY=replace-local-password
PII_TOKEN_SALT=replace-with-random-salt
RUNTIME_PROFILE=local
ENABLE_AUDIT_STORE=false
AUDIT_BACKEND=s3
AUDIT_RETENTION_DAYS=2555
AUDIT_LOCK_MODE=COMPLIANCE
AUDIT_S3_TIMEOUT_SECONDS=3
AUDIT_S3_MAX_ATTEMPTS=3
ENABLE_KAFKA=false
KAFKA_MAX_BLOCK_MS=500
KAFKA_REQUEST_TIMEOUT_MS=3000
ENABLE_VECTOR_STORE=false
MEMORY_STORE_MAX_DOCUMENTS=10000
ENABLE_SEARCH_STORE=false
SEARCH_AUTH_MODE=none
SEARCH_TIMEOUT_SECONDS=3
SEARCH_MAX_RETRIES=3
ENABLE_OLLAMA_INFERENCE=false
S3_ENDPOINT_URL=http://minio:9000
AUDIT_BUCKET=rag-audit
# Azure only: set AUDIT_BACKEND=azure_blob, use a Key Vault/external-secret
# projection for this connection value, and provision container immutability.
# AZURE_STORAGE_CONNECTION_STRING=replace-with-secret-manager-value
# AZURE_AUDIT_CONTAINER=rag-audit
